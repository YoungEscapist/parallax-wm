// Экранный шейдер parallax: дымка «как в референсе».
//
// Включается так:  set{ screen_shader = "~/.config/parallax/shaders/haze.frag" }
// Формат — хайпрлендовский (decoration:screen_shader), плюс одна текстура
// parallax — `bloom`: тот же кадр, ужатый и размытый гауссом в композиторе.
//
// Прошлая версия тонировала весь кадр средним цветом, поднимала чёрное,
// притушивала насыщенность и срезала света — все четыре шага СНИМАЮТ контраст,
// отсюда «мутно, цвета не чёткие». В референсе наоборот: обои сочные и
// контрастные (тёмные волосы остаются тёмными), а дымка — это только свет,
// который растекается от светлых мест на соседние. Так и сделано:
//
//   * GLOW     — светлая часть размытого кадра ложится поверх режимом
//                «экран». Режим «экран» только ДОБАВЛЯЕТ свет: детали и
//                резкость исходника не трогаются, а тёмное рядом со светлым
//                подсвечивается его же цветом (розовое — розовым);
//   * GLOW_CUT — с какой яркости размытого кадра начинается свечение;
//   * DREAM    — «мягкий свет» размытого кадра: местный контраст и цвет
//                усиливаются, картинка становится объёмнее, а не серее;
//   * VIBRANCE — добавка насыщенности тусклым цветам (яркие почти не трогает);
//   * EXPOSURE — общее снижение яркости всего кадра одним множителем (1.0 —
//                как было; см. разбор ниже — заменил S-кривую и точечный
//                зажим белого, оба ломали контраст, а не снимали его).
//
// Всё по отдельности гасится нулём. Файл перечитывается на лету.

precision highp float;

varying vec2 v_texcoord;
uniform sampler2D tex;
uniform sampler2D bloom;
uniform float time;
uniform vec2 wl_output_resolution;

const float GLOW      = 1.00;
const float GLOW_CUT  = 0.25;
const float DREAM     = 0.60;
const float VIBRANCE  = 0.25;
// CONTRAST (S-кривая) и точечный потолок для «почти-белого» — обе версии
// оказались не тем инструментом (18.09): S-кривая буквально усиливает
// контраст, а зажим ТОЛЬКО ярких пикселей ломает HUD в Dota 2 (числа и
// иконки превращаются в серую кашу, когда стоит рядом обычный текст той же
// яркости) и никак не снимает жалобу на Firefox — его панель не белая, а
// светло-серая, под порог зажима не попадает вовсе.
//
// EXPOSURE — общее снижение яркости ВСЕГО кадра одним множителем, как обычный
// ползунок яркости монитора. Топит и белое, и полутона вместе, поэтому
// СООТНОШЕНИЕ яркостей (то есть контраст между HUD-текстом и фоном) не рвётся
// — в отличие от точечного зажима, который топит только самое яркое и от
// этого рядом стоящий текст той же яркости выглядит рябью.
const float EXPOSURE  = 0.82;

float luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

vec3 soft_light(vec3 a, vec3 b) {
    return mix(2.0 * a * b + a * a * (1.0 - 2.0 * b),
               sqrt(a) * (2.0 * b - 1.0) + 2.0 * a * (1.0 - b),
               step(0.5, b));
}

void main() {
    vec4 src = texture2D(tex, v_texcoord);
    vec3 color = src.rgb;
    vec3 b = texture2D(bloom, v_texcoord).rgb;

    // Объём: мягкий свет размытой копии.
    color = mix(color, soft_light(color, b), DREAM);

    // Свечение от светлого. На то, что и так уже светлое (белый текст, белые
    // элементы), свечение не добавляем — иначе оно слипается в чистый (1,1,1)
    // и режет глаз; спадает от 0.6 до 0.95 по яркости самого исходника.
    float lb = luma(b);
    float k = smoothstep(GLOW_CUT, 1.0, lb);
    float already_bright = smoothstep(0.6, 0.95, luma(color));
    vec3 glow = clamp(b * k * GLOW, 0.0, 1.0) * (1.0 - already_bright);
    color = 1.0 - (1.0 - color) * (1.0 - glow);

    // Насыщенность тусклым цветам.
    float l = luma(color);
    float sat = max(max(color.r, color.g), color.b) - min(min(color.r, color.g), color.b);
    color = mix(vec3(l), color, 1.0 + VIBRANCE * (1.0 - sat));

    // Общая яркость — последним шагом, одним множителем на весь кадр.
    color *= EXPOSURE;

    gl_FragColor = vec4(clamp(color, 0.0, 1.0), src.a);
}
