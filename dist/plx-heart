#!/bin/sh
# Сердце в терминал — жест `love` («я тебя люблю» на жестовом) в вебку.
#
# Отдельным скриптом, а не строкой в конфиге: рисунок многострочный, и ни
# кавычки, ни переводы строк не проходят тогда через Lua и через `sh -c`
# композитора.
#
# Имена переменных ЛАТИНИЦЕЙ: /bin/sh здесь dash, а он не допускает кириллицу
# в именах — присваивание превращается в «команда не найдена».
#
# Цвет берётся из палитры обоев (plx-wall пишет её в ~/.cache/plx-wall), чтобы
# сердце оказалось в тон рабочему столу. Нет палитры — розовый по умолчанию.
r=235
g=80
b=120
pal="$HOME/.cache/plx-wall/shell-colors.zsh"
if [ -r "$pal" ]; then
    acc=$(sed -n "s/^PLX_ACCENT='#\([0-9a-fA-F]\{6\}\)'.*/\1/p" "$pal" | head -n1)
    if [ -n "$acc" ]; then
        r=$(printf '%d' "0x$(echo "$acc" | cut -c1-2)" 2>/dev/null) || r=235
        g=$(printf '%d' "0x$(echo "$acc" | cut -c3-4)" 2>/dev/null) || g=80
        b=$(printf '%d' "0x$(echo "$acc" | cut -c5-6)" 2>/dev/null) || b=120
    fi
fi

printf '\n\033[38;2;%d;%d;%dm' "$r" "$g" "$b"
cat <<'ART'
          ▄▄▄▄▄     ▄▄▄▄▄
         ███████   ███████
        ███████████████████
         █████████████████
          ███████████████
           █████████████
            ███████████
             █████████
              ███████
               █████
                ███
                 █
ART
printf '\033[0m\n             parallax\n\n'
printf '  Жест «love» в вебку. Закрыть — любая клавиша.\n\n'

# Ждём клавишу, не требуя Enter, — окно закроется само и не останется висеть.
# Без сырого режима (запуск не с терминала) просто ждём строку.
if old=$(stty -g 2>/dev/null); then
    stty -icanon -echo min 1 time 0 2>/dev/null
    dd bs=1 count=1 >/dev/null 2>&1
    stty "$old" 2>/dev/null
else
    read -r _
fi
