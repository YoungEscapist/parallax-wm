# Мусор харнесса: подставной HOME, созданный из-за незаданной переменной
# (кириллическое имя переменной bash не подставляет — см. build.sh, та же грабля)
/$КОРЕНЬ/
/$р/

# Одноразовые скрипты-заплатки самого начала проекта: правили `src/udev.rs` и
# `src/input.rs` по регулярным выражениям, лежали в git с первого коммита и
# ссылаются на путь `~/dev/parallax`, которого давно нет. Запустить их нельзя,
# а постороннему они говорят о проекте неправду. Файлы остались на диске.
/autofix.py
/autofix2.py
/autopatch.py
/autopatch2.py
/autopatch3.py

# Личное, в релиз не идёт: остаётся на диске, но не в репозитории.
# `anvil_reference.txt` — это ДОСЛОВНЫЙ кусок исходников anvil из smithay
# (лицензия MIT). Держать чужой код в GPL-репозитории без его лицензии нельзя,
# а для работы он и не нужен: это шпаргалка, а не часть Parallax.
/anvil_reference.txt
/extract_anvil.sh
/fix_tty.patch

