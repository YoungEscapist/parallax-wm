#!/usr/bin/env python3
"""plx-host — share your desktop with a guest, from the terminal.

    plx-host              show the state (code, addresses, who is connected)
    plx-host start [port] start sharing (port 7373 by default)
    plx-host stop         stop it
    plx-host watch        the same as status, refreshed every second

The guest connects with plx-share; the line with the address and the code is
printed here ready to be read out loud.

The socket is found on its own: `PLX_CTL_SOCKET`, else
$XDG_RUNTIME_DIR/plx-<display>.ctl.
"""
# Отдельная команда, а не `ctl.py 'action share_start'`, потому что действие
# умеет ответить только «ok» — а человеку нужен КОД и АДРЕС.
#
# Докстрока — это и есть `--help`, поэтому она английская, и объяснение почему
# живёт здесь, а не в ней.
#
# СВОИ строки этой команды (help и две жалобы ниже) языку из `set{ lang }` не
# следуют, как не следуют ему логи. Иначе и нельзя: «сокета нет» печатается
# ровно тогда, когда спросить композитор про язык НЕ У КОГО. Ответы самого
# композитора идут как есть и выбранному языку следуют — их эта команда только
# передаёт.
import glob
import os
import socket
import sys
import time


def найти_сокет():
    явный = os.environ.get("PLX_CTL_SOCKET")
    if явный:
        return явный
    каталог = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    дисплей = os.environ.get("WAYLAND_DISPLAY")
    if дисплей:
        путь = os.path.join(каталог, f"plx-{дисплей}.ctl")
        if os.path.exists(путь):
            return путь
    # Запустили из чужого окружения (tty, ssh, cron) — берём единственный
    # сокет, какой есть. Двух живых parallax на одной машине не бывает: второй не
    # получил бы DRM-мастера.
    найденные = sorted(glob.glob(os.path.join(каталог, "plx-*.ctl")))
    if len(найденные) == 1:
        return найденные[0]
    if not найденные:
        return None
    print("plx-host: several sessions, pick one with PLX_CTL_SOCKET:", file=sys.stderr)
    for п in найденные:
        print(f"  {п}", file=sys.stderr)
    sys.exit(2)


def спросить(сокет, команда):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(5)
    s.connect(сокет)
    s.sendall((команда + "\n").encode())
    s.shutdown(socket.SHUT_WR)
    данные = b""
    while True:
        кусок = s.recv(65536)
        if not кусок:
            break
        данные += кусок
    s.close()
    return данные.decode(errors="replace").rstrip("\n")


def main():
    # Справка ПЕРЕД поиском сокета: `--help` спрашивают как раз тогда, когда
    # ещё ничего не запущено, и отвечать на него «сокета нет» (да ещё кодом 1)
    # — худшее, что команда может сделать.
    доводы = sys.argv[1:]
    if доводы and доводы[0] in ("-h", "--help", "помощь"):
        print(__doc__)
        return 0

    сокет = найти_сокет()
    if not сокет:
        print(
            "plx-host: no parallax control socket found.\n"
            "  Is parallax running? Run this from its session, or point at the\n"
            "  socket: PLX_CTL_SOCKET=/run/user/1000/plx-wayland-1.ctl",
            file=sys.stderr,
        )
        return 1

    if доводы and доводы[0] == "watch":
        try:
            while True:
                ответ = спросить(сокет, "share status")
                # \033[2J\033[H — очистить экран и увести курсор в угол:
                # обновление на месте, без ленты одинаковых блоков.
                print("\033[2J\033[H" + ответ, flush=True)
                time.sleep(1)
        except KeyboardInterrupt:
            return 0

    команда = "share " + " ".join(доводы) if доводы else "share status"
    ответ = спросить(сокет, команда)
    print(ответ)
    # Оба языка: композитор отвечает на том, который выбран в config.lua
    # (`set{ lang = … }`), а код возврата от языка зависеть не должен — по нему
    # эту команду зовут из скриптов.
    return 1 if ответ.startswith(("ошибка", "error")) else 0


if __name__ == "__main__":
    sys.exit(main())
